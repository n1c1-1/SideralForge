         assert diag["noise"][name] == pytest.approx(direct, rel=0.35)
 
 
+def test_the_fine_detail_from_the_luminance_takes_a_peak_of_one_colour_for_noise_and_keeps_the_stars():
+    """A peak of one colour (the tail of its noise) is not a detail: its finest part goes, as the noise around it
+    does (stack version 5; the gate on the luminance alone kept it, so it stood out of a smoother sky). A star, seen
+    in the three colours, keeps its fine shape and its colour."""
+    import torch
+
+    from astro_gpu.stages.stack import luminance_detail
+    rng = np.random.default_rng(3)
+    H, W = 160, 160
+    img = 100 + rng.normal(0, 1, (3, H, W)).astype(np.float32)
+    peaks = [(y, x) for y in range(12, 72, 12) for x in range(12, 148, 12)]           # 60 lone blue peaks
+    for y, x in peaks:
+        img[2, y, x] += 12
+    yy, xx = np.mgrid[0:H, 0:W]
+    star = np.exp(-((yy - 120) ** 2 + (xx - 80) ** 2) / (2 * 1.2 ** 2)).astype(np.float32)
+    img += np.array([300, 240, 150], np.float32)[:, None, None] * star             # a star, redder than the sky
+    cover = torch.ones(H, W, dtype=torch.bool)
+    out = luminance_detail(img.copy(), cover, np.ones(3), 1.0, "cpu")
+
+    def fine(a, c):                                     # a pixel's excess over its 8 neighbours
+        return np.array([a[c, y, x] - (a[c, y - 1:y + 2, x - 1:x + 2].sum() - a[c, y, x]) / 8 for y, x in peaks])
+    before, after = fine(img, 2), fine(out, 2)
+    assert np.median(before) > 10 and np.median(after) < 0.5 * np.median(before)
+    sky = (slice(80, 100), slice(10, 150))                                           # the colour grain goes too
+    for c in range(3):
+        assert out[c][sky].std() < 0.8 * img[c][sky].std()
+    for c in range(3):                                   # the star: its peak and its flux in a small aperture
+        s = (slice(116, 125), slice(76, 85))
+        assert out[c, 120, 80] == pytest.approx(img[c, 120, 80], rel=0.03)
+        assert out[c][s].sum() == pytest.approx(img[c][s].sum(), rel=0.01)
+
+
